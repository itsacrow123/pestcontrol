---
pagination:
  data: cities
  size: 1
  alias: city
permalink: "pest-control/{{ city.slug }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pest Control in {{ city.city }}, IL | Call (866)-332-0652</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#f7f9f7;color:#111;line-height:1.7}
.container{width:92%;max-width:1200px;margin:auto}

.hero{
background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=1600&auto=format&fit=crop') center/cover;
color:#fff;padding:120px 0;
}

.hero h1{font-size:56px;margin-bottom:20px}
.hero p{font-size:20px;max-width:800px}

.call-btn{
display:inline-block;
margin-top:25px;
background:#d62828;
color:#fff;
padding:16px 30px;
border-radius:12px;
font-weight:700;
text-decoration:none;
}

.section{padding:70px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px}
.card{
background:#fff;
padding:24px;
border-radius:18px;
box-shadow:0 10px 25px rgba(0,0,0,.08)
}

.image-row{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
margin-top:30px;
}
.image-row img{
width:100%;
height:250px;
object-fit:cover;
border-radius:20px;
}

.sticky-call{
position:fixed;
bottom:0;
left:0;
right:0;
padding:12px;
z-index:9999;
display:none;
}
.sticky-call a{
display:block;
background:#ff7a00;
color:#fff;
font-weight:800;
text-align:center;
padding:18px;
border-radius:14px;
text-decoration:none;
}

@media(max-width:768px){
.hero h1{font-size:38px}
.image-row{grid-template-columns:1fr}
.sticky-call{display:block}
}
</style>
</head>
<body>

<section class="hero">
<div class="container">
<h1>Pest Control in {{ city.city }}, Illinois</h1>
<p>{{ city.intro }}</p>
<a href="tel:18663320652" class="call-btn">📞 Call Now (866)-332-0652</a>
</div>
</section>

<section class="section">
<div class="container">

<div class="image-row">
<img src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?q=80&w=1200&auto=format&fit=crop" alt="Pest Control">
<img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=1200&auto=format&fit=crop" alt="Technician">
<img src="https://images.unsplash.com/photo-1621905252507-b35492cc74b4?q=80&w=1200&auto=format&fit=crop" alt="Inspection">
</div>

<h2 style="margin:40px 0 20px">About {{ city.city }}</h2>
<div class="card">
<p>{{ city.city }} is located in {{ city.county }} with a population of {{ city.population }}.</p>
</div>

<h2 style="margin:40px 0 20px">Popular Landmarks</h2>
<div class="grid">
{% for landmark in city.landmarks %}
<div class="card">{{ landmark }}</div>
{% endfor %}
</div>

<h2 style="margin:40px 0 20px">Common Pest Problems</h2>
<div class="grid">
{% for pest in city.common_pests %}
<div class="card">
<h3>{{ pest }}</h3>
<p>Professional treatment and inspection services for {{ pest | lower }} activity in {{ city.city }}.</p>
</div>
{% endfor %}
</div>

</div>
</section>

<div class="sticky-call">
<a href="tel:18663320652">📞 CALL NOW — (866)-332-0652</a>
</div>

</body>
</html>
